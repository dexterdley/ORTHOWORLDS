; Engine configuration file.
; OrthoWorlds hi-fi renderer: one Godot 4.3+ project for every GymBox env (see hifi/README.md).

config_version=5

[application]

config/name="OrthoWorlds HiFi"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
run/max_fps=0

[display]

window/size/viewport_width=960
window/size/viewport_height=640
window/vsync/vsync_mode=0

[rendering]

lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
anti_aliasing/quality/use_debanding=false
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
textures/default_filters/anisotropic_filtering_level=3
environment/ssao/quality=3
environment/ssil/quality=2

[shader_globals]

sim_time={
"type": "float",
"value": 0.0
}
